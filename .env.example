# API
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=https://xiaoshou.qycm.top
PUBLIC_APP_URL=https://xiaoshou.qycm.top
VITE_API_BASE_URL=https://xiaoshou-api.qycm.top
RETENTION_DAYS=365
# inline 用于本地；external 用于 PostgreSQL + S3 的独立 Worker
WORKER_MODE=inline

# Main-site SSO. In production, CORS_ORIGIN must be the deployed frontend origin.
MAIN_APP_URL=https://www.qycm.top
MAIN_APP_SSO_EXCHANGE_URL=https://www.qycm.top/api/external-sso/xiaoshou/exchange
MAIN_APP_SSO_CLIENT_SECRET=replace-with-the-xiaoshou-main-site-secret
APP_SESSION_SECRET=replace-with-a-unique-xiaoshou-session-secret

# file (local persistent), memory (temporary demo), or postgres
REPOSITORY_DRIVER=file
LOCAL_DATA_DIR=.data
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sales_agent

# file (local persistent), memory (temporary demo), or s3
OBJECT_STORAGE_DRIVER=file
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=sales-agent-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# rule_based or openai_compatible
MODEL_DRIVER=rule_based
# Only the exact value true lets analysis retrieve and cite the knowledge base.
ANALYSIS_KNOWLEDGE_ENABLED=false
# openai_chat or gemini_generate_content
MODEL_API_STYLE=openai_chat
# bearer, api_key_header or query. Gemini-compatible services usually use api_key_header or query.
MODEL_AUTH_MODE=bearer
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1
KNOWLEDGE_MODEL_NAME=gpt-4.1
BATCH_MODEL_NAME=gpt-4.1-mini
EMBEDDING_API_STYLE=openai
EMBEDDING_BASE_URL=https://yunwu.ai
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=sales_knowledge_text_embedding_3_small_1536_v1
QDRANT_COLLECTION_ALIAS=sales_knowledge_current
QDRANT_TIMEOUT_MS=10000
KNOWLEDGE_IMPORT_MAX_TOTAL_MB=500

# Yunwu Gemini-compatible example:
# MODEL_DRIVER=openai_compatible
# MODEL_API_STYLE=gemini_generate_content
# MODEL_AUTH_MODE=api_key_header
# MODEL_BASE_URL=https://yunwu.ai
# MODEL_NAME=gemini-3.1-flash-lite
# KNOWLEDGE_MODEL_NAME=gemini-3.1-flash-lite
# BATCH_MODEL_NAME=gemini-3.1-flash-lite
