{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../server-dist",
    "rootDir": "..",
    "types": ["node"],
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
